rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES HELPER GLOBALES
    // =========================================================================

    // Comprueba si el usuario está autenticado en Firebase
    function estaAutenticado() {
      return request.auth != null;
    }

    // Comprueba si el usuario es el Super-Admin Master de Fiabono
    function esMaster() {
      return estaAutenticado() && request.auth.token.email == 'johanescobar1@gmail.com';
    }

    // Obtiene los datos del usuario actual desde la colección usuarios de forma segura
    function datosUsuarioActual() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : null;
    }

    // Devuelve el ID de la cuenta principal (si es cajero devuelve su adminId, si es admin su uid)
    function idCuentaPrincipal() {
      let u = datosUsuarioActual();
      return (u != null && u.rol == 'cajero' && u.adminId != null) ? u.adminId : request.auth.uid;
    }

    // Verifica si el recurso pertenece al tenant/negocio del usuario actual
    function perteneceAlNegocio(docData) {
      return estaAutenticado() && (
        docData.usuarioId == request.auth.uid ||
        docData.usuarioId == idCuentaPrincipal() ||
        esMaster()
      );
    }

    // =========================================================================
    // 1. COLECCIÓN: USUARIOS (Cuentas de Negocio y Colaboradores/Cajeros)
    // =========================================================================
    match /usuarios/{userId} {
      // PARCHE P0-SEC-03: Se eliminó 'allow get: if true' que exponía correo,
      // celular y NIT a cualquier persona que conociese el UID.
      // Los comprobantes públicos /t/[id] ahora usan la ruta API del servidor
      // con Admin SDK para obtener los datos del negocio sin exponer la colección completa.
      allow get: if estaAutenticado() && (
        request.auth.uid == userId ||
        resource.data.adminId == request.auth.uid ||
        esMaster()
      );
      allow list: if estaAutenticado() && (
        resource.data.adminId == request.auth.uid ||
        resource.data.rol == 'admin' && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        esMaster()
      );

      // Crear usuario:
      // - Nuevo registro de admin (su propio uid)
      // - Un admin creando un colaborador cajero (con secondary auth)
      // - Master
      allow create: if estaAutenticado() && (
        request.auth.uid == userId ||
        request.resource.data.adminId == request.auth.uid ||
        esMaster()
      );

      // Actualizar usuario:
      // PARCHE P0-SEC-01: Se eliminó la cláusula que permitía al usuario
      // auto-asignarse planes 'comercio' o 'pro'. Ahora el único flujo
      // legítimo de cambio de plan es:
      //   a) El Master (control absoluto)
      //   b) El propio usuario bajando voluntariamente a 'gratis' (con planVence=null)
      //   c) Un admin actualizando permisos de su colaborador
      // La activación de planes PRO/Comercio vía cupón debe hacerse
      // a través de una Cloud Function con Admin SDK.
      allow update: if estaAutenticado() && (
        esMaster() ||
        (
          request.auth.uid == userId && (
            // Puede actualizar datos de perfil sin tocar plan ni fechas de vencimiento
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planVence', 'cicloPlan']) ||
            // O bajando voluntariamente a plan gratuito (con planVence nulo)
            (request.resource.data.plan == 'gratis' && request.resource.data.planVence == null)
          )
        ) ||
        // Un admin actualizando el estado activo o permisos de su colaborador
        (resource.data.adminId == request.auth.uid)
      );

      // Eliminar: Un admin puede eliminar a sus colaboradores, o el Master
      allow delete: if estaAutenticado() && (
        resource.data.adminId == request.auth.uid ||
        request.auth.uid == userId ||
        esMaster()
      );
    }

    // =========================================================================
    // 2. COLECCIONES DE NEGOCIO (Multi-Tenant por cuenta principal)
    // =========================================================================
    
    // Inventario / Productos del Negocio
    match /inventario/{prodId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }
    match /productos/{prodId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Clientes y Cartera
    match /clientes/{clienteId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Movimientos (Ventas, Gastos, Fiados, Abonos)
    // 'get' individual público para comprobantes /t/[id].
    // La lista completa sigue protegida al negocio.
    match /movimientos/{movId} {
      allow get: if true;
      allow list: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Planes Separe
    // 'get' individual público para comprobantes /t/[id].
    match /separes/{separeId} {
      allow get: if true;
      allow list: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Órdenes Pendientes (Aprobación de Cajeros)
    match /ordenes_pendientes/{ordenId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Categorías de Productos
    match /categorias/{catId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // Cierres de Caja
    match /cierres_caja/{cierreId} {
      allow read: if estaAutenticado() && perteneceAlNegocio(resource.data);
      allow create: if estaAutenticado() && (request.resource.data.usuarioId == idCuentaPrincipal() || esMaster());
      allow update, delete: if estaAutenticado() && perteneceAlNegocio(resource.data);
    }

    // =========================================================================
    // 3. MONETIZACIÓN: CÓDIGOS PROMOCIONALES & BONOS
    // =========================================================================
    match /codigos_promocionales/{codigoId} {
      // Solo usuarios autenticados pueden verificar un código individual.
      // Se eliminó 'if true' para evitar enumeración pública de códigos.
      allow get: if estaAutenticado();
      allow list: if estaAutenticado() && esMaster();

      // Solo el Master puede crear o eliminar códigos promocionales
      allow create, delete: if esMaster();

      // Al canjear un código, el usuario puede marcarlo como activo: false (para quemarlo).
      // La activación del plan resultado se hace vía Cloud Function (Admin SDK),
      // no directamente desde el cliente.
      allow update: if estaAutenticado() && (
        esMaster() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo']) && request.resource.data.activo == false)
      );
    }

    // =========================================================================
    // 4. ANUNCIOS DEL SISTEMA
    // =========================================================================
    match /anuncios/{anuncioId} {
      // Todos los usuarios autenticados pueden ver los anuncios del sistema
      allow read: if estaAutenticado();

      // Solo el Master puede crear, modificar o borrar anuncios
      allow write: if esMaster();
    }

  }
}
