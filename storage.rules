rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function estaAutenticado() {
      return request.auth != null;
    }

    function esDuenioOColaborador(negocioId) {
      return estaAutenticado() && (
        request.auth.uid == negocioId ||
        (
          firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.adminId == negocioId
        )
      );
    }

    match /logos/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /negocios/{negocioId}/{allPaths=**} {
      allow read: if true;
      allow write: if esDuenioOColaborador(negocioId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
